    <td height="24" class="section-spacer" style="font-size: 1px; line-height: 1px;">&nbsp;</td>
  </tr>
</table>

<!-- Order Summary Table -->
<table width="100%" cellpadding="0" cellspacing="0" border="0" style="font-family: Helvetica, Arial, sans-serif;">
  <tr>
    <td>
      <h3
        style="font-size: 18px; font-weight: 700; color: #111827; margin: 0 0 16px 0; font-family: Helvetica, Arial, sans-serif;">
        Order Items
      </h3>

      <table width="100%" cellpadding="0" cellspacing="0" border="0">
        <!-- Header row (Desktop only) -->
        <tr class="mobile-hide">
          <th align="left"
            style="padding: 12px 0; font-size: 14px; font-weight: 700; color: #9CA3AF; border-bottom: 1px solid #E5E7EB;">
            Item</th>
          <th align="center"
