<h1>Thank You for Your Order!</h1>
<p>Hello {{name}},</p>
<p>Your order <strong>#{{orderNumber}}</strong> has been successfully placed. We are processing your items and will send a shipment notification as soon as they are on their way.</p>

<table width="100%" cellpadding="0" cellspacing="0" style="margin-bottom: 24px;">
  <tr>
    <td style="font-size: 14px; color: #6B7280; padding-bottom: 8px;">Order Date: <strong>{{orderDate}}</strong></td>
    <td align="right" style="font-size: 14px; color: #6B7280; padding-bottom: 8px;">Payment Method: <strong>{{paymentMethod}}</strong></td>
  </tr>
</table>

<div class="divider"></div>

<h3>Shipping Address</h3>
<p style="background-color: #FAFAFC; border: 1px solid #E5E7EB; border-radius: 8px; padding: 16px; font-size: 14px; line-height: 1.5; color: #4B5563; margin-bottom: 24px;">
  <strong>{{shippingAddress.recipientName}}</strong><br>
  {{shippingAddress.street}}<br>
  {{#if shippingAddress.addressLine2}}{{shippingAddress.addressLine2}}<br>{{/if}}
  {{shippingAddress.city}}, {{shippingAddress.state}} {{shippingAddress.zipCode}}<br>
  {{shippingAddress.country}}<br>
  Phone: {{shippingAddress.phoneNumber}}
</p>

<h3>Order Summary</h3>
<table width="100%" cellpadding="0" cellspacing="0" style="margin-bottom: 24px;">
  <thead>
    <tr style="border-bottom: 2px solid #E5E7EB;">
      <th align="left" style="padding: 8px 0; font-size: 13px; text-transform: uppercase; color: #9CA3AF;">Item</th>
      <th align="center" style="padding: 8px 0; font-size: 13px; text-transform: uppercase; color: #9CA3AF;">Qty</th>
      <th align="right" style="padding: 8px 0; font-size: 13px; text-transform: uppercase; color: #9CA3AF;">Price</th>
    </tr>
  </thead>
  <tbody>
    {{#each items}}
    <tr style="border-bottom: 1px solid #F3F4F6;">
      <td style="padding: 12px 0;">
        <table cellpadding="0" cellspacing="0">
          <tr>
            {{#if product.thumbnail}}
            <td style="padding-right: 12px;">
              <img src="{{product.thumbnail}}" alt="{{product.name}}" width="48" height="48" style="border-radius: 8px; object-fit: cover; border: 1px solid #E5E7EB;">
            </td>
            {{/if}}
            <td>
              <span style="font-size: 14px; font-weight: 600; color: #111827;">{{product.name}}</span><br>
              <span style="font-size: 12px; color: #9CA3AF;">SKU: {{product.sku}}</span>
            </td>
          </tr>
        </table>
      </td>
      <td align="center" style="padding: 12px 0; font-size: 14px; color: #4B5563;">{{quantity}}</td>
      <td align="right" style="padding: 12px 0; font-size: 14px; font-weight: 600; color: #111827;">{{formattedPrice}}</td>
    </tr>
    {{/each}}
  </tbody>
</table>

<table width="100%" cellpadding="0" cellspacing="0" style="margin-bottom: 24px; font-size: 14px; color: #4B5563;">
  <tr>
    <td style="padding: 6px 0;">Subtotal</td>
    <td align="right" style="padding: 6px 0; font-weight: 600;">{{formattedSubtotal}}</td>
  </tr>
  {{#if discountAmount}}
  <tr>
    <td style="padding: 6px 0; color: #DC2626;">Discount</td>
    <td align="right" style="padding: 6px 0; font-weight: 600; color: #DC2626;">-{{formattedDiscount}}</td>
  </tr>
  {{/if}}
  <tr>
    <td style="padding: 6px 0;">Shipping</td>
    <td align="right" style="padding: 6px 0; font-weight: 600;">{{formattedShipping}}</td>
  </tr>
  <tr>
    <td style="padding: 6px 0;">GST / Tax</td>
    <td align="right" style="padding: 6px 0; font-weight: 600;">{{formattedTax}}</td>
  </tr>
  <tr style="font-size: 16px; color: #111827; font-weight: 800; border-top: 2px solid #E5E7EB;">
    <td style="padding: 16px 0 0 0;">Grand Total</td>
    <td align="right" style="padding: 16px 0 0 0; color: #4C4DDC;">{{formattedTotal}}</td>
  </tr>
</table>

{{> button url=trackUrl text="Track Your Order"}}

<table width="100%" cellpadding="0" cellspacing="0" style="text-align: center; margin-top: 12px;">
  <tr>
    <td>
      <a href="{{shopUrl}}" style="color: #6B7280; font-size: 14px; font-weight: 600; text-decoration: none; margin: 0 16px;">Continue Shopping</a>
      <a href="{{invoiceUrl}}" style="color: #6B7280; font-size: 14px; font-weight: 600; text-decoration: none; margin: 0 16px;">Download Invoice</a>
    </td>
  </tr>
</table>
