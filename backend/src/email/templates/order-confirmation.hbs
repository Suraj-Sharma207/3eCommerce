            </span>{{formattedPrice}}
          </td>
        </tr>

        <!-- Separator Below Row (Mobile only, separates stacked items) -->
        <tr style="display: none;" class="mobile-stack">
          <td colspan="3" style="border-bottom: 1px solid #E5E7EB; padding-bottom: 12px;"></td>
        </tr>
        {{/each}}

        <!-- Final Divider below all rows (Desktop only) -->
        <tr class="mobile-hide">
          <td colspan="3" style="border-top: 1px solid #E5E7EB;"></td>
        </tr>
      </table>
    </td>
  </tr>
</table>

