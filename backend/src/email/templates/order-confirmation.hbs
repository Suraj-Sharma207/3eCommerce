            Qty</th>
          <th align="right"
            style="padding: 12px 0; font-size: 14px; font-weight: 700; color: #9CA3AF; border-bottom: 1px solid #E5E7EB; width: 100px; text-align: right;">
            Price</th>
        </tr>

        {{#each items}}
        <!-- Separator Above Row (Desktop only, mobile will use bottom border on stack) -->
        <tr class="mobile-hide">
          <td colspan="3" style="border-top: 1px solid #E5E7EB; padding-top: 12px;"></td>
        </tr>

        <tr class="item-row">
          <!-- Image + Product Name + SKU -->
          <td class="mobile-stack" valign="middle" style="padding: 12px 0; vertical-align: middle; text-align: left;">
