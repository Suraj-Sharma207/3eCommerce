            Order ID: <span style="color: #082F5C;">#{{orderNumber}}</span>
          </td>
        </tr>
      </table>
    </td>
  </tr>
</table>

<!-- Spacer -->
<table width="100%" cellpadding="0" cellspacing="0" border="0">
