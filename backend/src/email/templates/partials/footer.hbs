<table width="100%" cellpadding="0" cellspacing="0" border="0"
  style="background-color: #0B1533; color: #9CA3AF; font-family: Helvetica, Arial, sans-serif;">
  <tr>
    <td align="center" style="padding: 40px 24px;">

      <!-- Logo -->
      <table cellpadding="0" cellspacing="0" border="0" align="center">
        <tr>
          <td align="center" style="padding-bottom: 16px;">
            <a href="{{websiteUrl}}" style="text-decoration: none;">
              <span
                style="color: #ffffff; font-size: 24px; font-weight: 700; font-family: Helvetica, Arial, sans-serif; letter-spacing: -0.5px;">Luxe</span><span
                style="color: #5B5CEB; font-size: 24px; font-weight: 700; font-family: Helvetica, Arial, sans-serif; letter-spacing: -0.5px;">Home</span>
            </a>
          </td>
        </tr>
      </table>

      <!-- Description -->
      <table cellpadding="0" cellspacing="0" border="0" align="center">
        <tr>
          <td align="center" style="padding-bottom: 6px;">
            <span
              style="font-size: 13px; line-height: 1.6; color: #9CA3AF; font-family: Helvetica, Arial, sans-serif;">Premium
              Furniture for Modern Living</span>
          </td>
        </tr>
        <tr>
          <td align="center" style="padding-bottom: 28px;">
            <span
              style="font-size: 13px; line-height: 1.6; color: #9CA3AF; font-family: Helvetica, Arial, sans-serif;">Crafted
              for Comfort. Designed for You.</span>
          </td>
        </tr>
      </table>

      <!-- Follow Us Label -->
      <table cellpadding="0" cellspacing="0" border="0" align="center">
        <tr>
          <td align="center" style="padding-bottom: 12px;">
            <span
              style="font-size: 12px; font-weight: 700; color: #6B7280; font-family: Helvetica, Arial, sans-serif; text-transform: uppercase; letter-spacing: 1px;">Follow
              Us</span>
          </td>
        </tr>
      </table>

      <!-- Social Link Buttons (centered row) -->
      <table cellpadding="0" cellspacing="0" border="0" align="center" style="margin-bottom: 32px;">
        <tr>
          <td align="center" style="padding: 0 5px;">
            <a href="{{facebookUrl}}" target="_blank"
              style="color: #9CA3AF; text-decoration: none; font-size: 12px; font-family: Helvetica, Arial, sans-serif; font-weight: 600; border: 1px solid #374151; border-radius: 6px; padding: 6px 14px; display: inline-block;">Facebook</a>
          </td>
          <td align="center" style="padding: 0 5px;">
            <a href="{{instagramUrl}}" target="_blank"
              style="color: #9CA3AF; text-decoration: none; font-size: 12px; font-family: Helvetica, Arial, sans-serif; font-weight: 600; border: 1px solid #374151; border-radius: 6px; padding: 6px 14px; display: inline-block;">Instagram</a>
          </td>
          <td align="center" style="padding: 0 5px;">
            <a href="{{twitterUrl}}" target="_blank"
              style="color: #9CA3AF; text-decoration: none; font-size: 12px; font-family: Helvetica, Arial, sans-serif; font-weight: 600; border: 1px solid #374151; border-radius: 6px; padding: 6px 14px; display: inline-block;">X</a>
          </td>
        </tr>
      </table>

      <!-- Divider -->
      <table width="100%" cellpadding="0" cellspacing="0" border="0">
        <tr>
          <td style="border-top: 1px solid #1F2937; font-size: 1px; line-height: 1px;">&nbsp;</td>
        </tr>
      </table>

      <!-- Spacer -->
      <table width="100%" cellpadding="0" cellspacing="0" border="0">
        <tr>
          <td height="20" style="font-size: 1px; line-height: 1px;">&nbsp;</td>
        </tr>
      </table>

      <!-- Copyright (centered) -->
      <table cellpadding="0" cellspacing="0" border="0" align="center">
        <tr>
          <td align="center" style="padding-bottom: 6px;">
            <span style="font-size: 13px; color: #6B7280; font-family: Helvetica, Arial, sans-serif;">&copy; 2026
              LuxeHome. All rights reserved.</span>
          </td>
        </tr>
        <tr>
          <td align="center">
            <span style="font-size: 13px; color: #6B7280; font-family: Helvetica, Arial, sans-serif;">Powered by <a
                href="https://www.mobiloitte.com/"
                style="color: #9CA3AF; font-weight: 700; text-decoration: none; font-family: Helvetica, Arial, sans-serif;">Mobiloitte</a></span>
          </td>
        </tr>
      </table>

    </td>
  </tr>
</table>