<table width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color: #0b233f;">
  <tr>
    <td align="center" style="padding: 40px 20px;">
      <a href="{{shopUrl}}" style="text-decoration: none;">
        {{#if emailLogoUrl}}
        <img src="{{emailLogoUrl}}" alt="{{platformName}}" width="190" height="50" loading="eager"
          style="display: block; max-height: 50px; width: auto; max-width: 250px; border: 0;" border="0" />
        {{else}}
        <h1 class="main-heading"
          style="color: #ffffff; font-size: 32px; font-weight: 700; margin: 0; font-family: Helvetica, Arial, sans-serif; letter-spacing: -0.5px;">
          {{platformName}}
        </h1>
        {{/if}}
      </a>
    </td>
  </tr>
</table>