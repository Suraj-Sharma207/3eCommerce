<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{subject}}</title>
  <style>
    body {
      font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
      background-color: #FAFAFC;
      color: #111827;
      margin: 0;
      padding: 0;
      -webkit-font-smoothing: antialiased;
      -moz-osx-font-smoothing: grayscale;
    }
    table {
      border-collapse: collapse;
      width: 100%;
    }
    .wrapper {
      width: 100%;
      table-layout: fixed;
      background-color: #FAFAFC;
      padding: 40px 0;
    }
    .container {
      max-width: 600px;
      margin: 0 auto;
      background-color: #FFFFFF;
      border: 1px solid #E5E7EB;
      border-radius: 16px;
      overflow: hidden;
      box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05), 0 2px 4px -1px rgba(0, 0, 0, 0.025);
    }
    .content {
      padding: 32px 40px;
      text-align: left;
    }
    h1 {
      font-size: 24px;
      font-weight: 800;
      color: #111827;
      margin-top: 0;
      margin-bottom: 16px;
      line-height: 1.25;
    }
    p {
      font-size: 15px;
      line-height: 1.6;
      color: #4B5563;
      margin-top: 0;
      margin-bottom: 20px;
    }
    .divider {
      height: 1px;
      background-color: #E5E7EB;
      margin: 24px 0;
    }
    @media only screen and (max-width: 620px) {
      .wrapper {
        padding: 16px 0;
      }
      .container {
        border-radius: 0;
        border-left: none;
        border-right: none;
      }
      .content {
        padding: 24px 20px;
      }
    }
  </style>
</head>
<body>
  <center class="wrapper">
    <div class="container">
      {{> header}}
      <div class="content">
        {{{body}}}
      </div>
      {{> footer}}
    </div>
  </center>
</body>
</html>
