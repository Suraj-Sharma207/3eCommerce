<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd">
<html xmlns="http://www.w3.org/1999/xhtml">
<head>
  <meta http-equiv="Content-Type" content="text/html; charset=UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>{{subject}}</title>
  <style type="text/css">
    /* Reset Styles */
    body {
      margin: 0;
      padding: 0;
      min-width: 100%;
      background-color: #F3F4F6;
      font-family: Helvetica, Arial, 'Segoe UI', sans-serif;
      -webkit-font-smoothing: antialiased;
      -moz-osx-font-smoothing: grayscale;
    }
    table {
      border-spacing: 0;
      border-collapse: collapse;
    }
    td {
      padding: 0;
    }
    img {
      border: 0;
    }
    
    /* Wrapper */
    .wrapper {
      width: 100%;
      table-layout: fixed;
      background-color: #F3F4F6;
      padding: 40px 0;
    }
    .main-table {
      background-color: #ffffff;
      margin: 0 auto;
      width: 100%;
      max-width: 600px;
      border-radius: 16px;
      overflow: hidden;
      box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.1), 0 8px 10px -6px rgba(0, 0, 0, 0.1);
    }
    
    /* Utility */
    .content-padding {
      padding: 40px;
    }
    
    /* Typography */
    h1, h2, h3, p {
      margin: 0;
      color: #111827;
    }
    a {
      text-decoration: none;
      color: #082F5C;
    }

    .social-icon {
      display: inline-block;
      width: 32px;
      height: 32px;
      border: 1px solid #ffffff;
      border-radius: 50%;
      text-align: center;
      line-height: 30px;
      color: #ffffff !important;
      text-decoration: none;
      transition: all 0.3s ease;
    }
    .social-icon:hover {
      border-color: #082F5C !important;
      color: #082F5C !important;
      background-color: #ffffff !important;
    }

    /* Responsive Styles */
    @media screen and (max-width: 600px) {
      .wrapper {
        padding: 0 !important;
      }
      .main-table {
        border-radius: 0 !important;
        width: 100% !important;
        max-width: 100% !important;
      }
      .content-padding {
        padding: 16px !important;
      }
      .mobile-stack {
        display: block !important;
        width: 100% !important;
        box-sizing: border-box !important;
      }
      .mobile-center {
        text-align: center !important;
        margin: 0 auto !important;
      }
      .mobile-center-table {
        float: none !important;
        margin: 0 auto !important;
      }
      .mobile-hide {
        display: none !important;
        opacity: 0 !important;
        overflow: hidden !important;
        visibility: hidden !important;
        width: 0 !important;
        height: 0 !important;
      }
      .mobile-show {
        display: block !important;
        max-height: none !important;
        visibility: visible !important;
        overflow: visible !important;
        width: 100% !important;
      }
      .mobile-table {
        display: table !important;
        width: 100% !important;
      }
      .mobile-table-row {
        display: table-row !important;
      }
      .mobile-table-cell {
        display: table-cell !important;
      }
      .product-image {
        width: 64px !important;
        height: 64px !important;
      }
      .section-spacer {
        height: 24px !important;
      }
      .item-spacer {
        height: 16px !important;
      }
      .cta-button-table {
        width: 100% !important;
        max-width: 100% !important;
      }
      .cta-button-table a {
        padding: 14px 0 !important;
      }
      .shipping-card {
        padding: 16px !important;
      }
      /* Typography Overrides */
      .main-heading {
        font-size: 24px !important;
        line-height: 1.3 !important;
      }
      .section-title {
        font-size: 18px !important;
      }
      .product-title {
        font-size: 16px !important;
      }
      .product-sku, .product-label {
        font-size: 13px !important;
      }
      .product-price {
        font-size: 18px !important;
        font-weight: bold !important;
      }
    }
  </style>
  <!--[if mso]>
  <style type="text/css">
    body, table, td, p, a, h1, h2, h3 {font-family: Arial, Helvetica, sans-serif !important;}
  </style>
  <![endif]-->
</head>
<body style="margin: 0; padding: 0; background-color: #F3F4F6;">
  <center class="wrapper">
    <table class="main-table" align="center" border="0" cellpadding="0" cellspacing="0" width="100%" style="max-width: 600px; background-color: #ffffff; border-radius: 16px; margin: 0 auto;">
      <tr>
        <td>
          {{> header}}
        </td>
      </tr>
      <tr>
        <td class="content-padding" style="padding: 40px;">
          {{{body}}}
        </td>
      </tr>
      <tr>
        <td>
          {{> footer}}
        </td>
      </tr>
    </table>
  </center>
</body>
</html>
