# =============================================================================
# eCommerce Backend — Environment Variables
# =============================================================================
# Copy this file to .env and fill in real values. Never commit .env to git.
# =============================================================================

# Server
PORT=5000

# Database (PostgreSQL via Neon or local)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DBNAME?sslmode=require"

# JWT Authentication
# SECURITY: Must be at least 64 characters, cryptographically random.
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET="REPLACE_WITH_64_CHAR_RANDOM_SECRET"
JWT_EXPIRES_IN="1d"

# AES-256 Encryption Key
# SECURITY: Must be exactly 64 hex characters (32 bytes).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AES_SECRET_KEY="REPLACE_WITH_64_HEX_CHAR_KEY"

# Frontend URL (comma-separated for multiple origins)
FRONTEND_URL="http://localhost:5173"

# Cloudinary (Image Uploads)
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"

# SMTP Configuration (Email)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER="your-email@gmail.com"
SMTP_PASSWORD="your-app-password"
SMTP_FROM="Store Name <noreply@yourstore.com>"

# Admin Seeder (initial admin account)
DEFAULT_ADMIN_NAME="Admin"
DEFAULT_ADMIN_EMAIL="admin@yourstore.com"
DEFAULT_ADMIN_PASSWORD="REPLACE_WITH_STRONG_PASSWORD"

# Redis (Optional — falls back to in-memory cache if not set)
# REDIS_URL="redis://localhost:6379"

# Reverse Proxy (set to 'true' or '1' if behind Nginx/Cloudflare/ALB)
# TRUST_PROXY=false

# Bulk Operation Limits
# BULK_DELETE_MAX=100
