generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String
  role      Role     @default(CUSTOMER)
  
  phone      String?
  birthday   DateTime?
  gender     String?
  avatarUrl  String?
  avatarPublicId String?
  language   String    @default("en")
  currency   String    @default("USD")
  newsletter Boolean   @default(false)
  active     Boolean   @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  failedLoginAttempts Int      @default(0)
  lockoutUntil        DateTime?
  tokenVersion        Int      @default(0)
  passwordUpdatedAt   DateTime @default(now())
  
  verificationToken    String?
  verificationExpires  DateTime?
  resetPasswordToken   String?
  resetPasswordExpires DateTime?
  isEmailVerified      Boolean   @default(false)
  
  cart      Cart?
  orders    Order[]
  wishlist  Wishlist?
  addresses Address[]
  stockNotifications StockNotification[]
  emailLogs EmailLog[]
}

enum Role {
  CUSTOMER
  ADMIN
  SUPER_ADMIN
}

model Product {
  id                 String         @id @default(uuid())
  name               String
  slug               String?        @unique
  brand              String         @default("FurnitureCo")
  sku                String?        @unique
  description        String
  price              Float
  discountPercentage Float          @default(0)
  finalPrice         Float          @default(0)
  category           String         @default("Living Room")
  stock              Int            @default(0)
  rating             Float          @default(0)
  reviewCount        Int            @default(0)
  featured           Boolean        @default(false)
  trending           Boolean        @default(false)
  bestSeller         Boolean        @default(false)
  newArrival         Boolean        @default(false)
  active             Boolean        @default(true)
  recommended        Boolean        @default(false)

  homepageOrder      Int            @default(0)
  totalSold          Int            @default(0)
  totalRevenue       Float          @default(0)
  totalViews         Int            @default(0)
  wishlistCount      Int            @default(0)
  cartCount          Int            @default(0)
  lastPurchasedAt    DateTime?

  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  images             ProductImage[]
  cartItems          CartItem[]
  orderItems         OrderItem[]
  wishlistItems      WishlistItem[]
  stockNotifications StockNotification[]
  promotions         PromotionProduct[]

  @@index([stock])
  @@index([createdAt])
  @@index([category])
}

model ProductImage {
  id           String   @id @default(uuid())
  productId    String
  product      Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  url          String
  publicId     String?  @unique
  displayOrder Int      @default(0)
  isPrimary    Boolean  @default(false)
  altText      String?
  width        Int?
  height       Int?
  format       String?
  bytes        Int?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([productId, url])
  @@index([productId])
  @@index([productId, isPrimary])
}

model Cart {
  id        String     @id @default(uuid())
  userId    String     @unique
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model CartItem {
  id        String  @id @default(uuid())
  cartId    String
  productId String
  quantity  Int     @default(1)
  
  cart      Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([cartId, productId])
}

model Order {
  id              String      @id @default(uuid())
  orderNumber     String      @unique @default(uuid())
  userId          String
  user            User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  totalAmount     Float
  subtotal        Float       @default(0)
  discountAmount  Float       @default(0)
  taxAmount       Float       @default(0)
  shippingCharge  Float       @default(0)
  paymentStatus   PaymentStatus @default(PENDING)
  orderStatus     OrderStatus   @default(PENDING)
  paymentMethod   String?
  transactionRef  String?
  cardBrand       String?
  last4Digits     String?
  maskedUPI       String?
  shippingAddress Json?
  billingAddress  Json?
  items           OrderItem[]
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@index([userId])
  @@index([orderStatus])
  @@index([createdAt])
  @@index([paymentStatus])
}

model OrderItem {
  id        String  @id @default(uuid())
  orderId   String
  productId String
  quantity  Int
  price     Float
  
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([orderId])
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  PACKED
  SHIPPED
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
  RETURNED
  REFUNDED
}

model Wishlist {
  id        String         @id @default(uuid())
  userId    String         @unique
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     WishlistItem[]
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
}

model WishlistItem {
  id         String   @id @default(uuid())
  wishlistId String
  productId  String
  
  wishlist   Wishlist @relation(fields: [wishlistId], references: [id], onDelete: Cascade)
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([wishlistId, productId])
}

model Address {
  id                String   @id @default(uuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  recipientName     String
  phoneNumber       String
  label             String   @default("Home")
  street            String
  addressLine2      String?
  landmark          String?
  city              String
  state             String
  zipCode           String
  country           String
  isDefaultShipping Boolean  @default(false)
  isDefaultBilling  Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model StockNotification {
  id         String   @id @default(uuid())
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  email      String
  phone      String?
  isNotified Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@unique([productId, email])
}

model SystemSettings {
  id        String   @id @default(uuid())
  key       String   @unique
  value     Json
  updatedAt DateTime @updatedAt

  @@map("Setting")
}

model Promotion {
  id            String             @id @default(uuid())
  name          String
  description   String?
  type          CampaignType
  status        CampaignStatus     @default(DISABLED)
  priority      Int                @default(0)
  startDate     DateTime
  endDate       DateTime
  applyTo       ApplyToType        @default(STORE)
  
  discountValue Float              @default(0)
  buyQty        Int?
  getYQty       Int?
  minPurchase   Float?
  couponCode    String?            @unique
  
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  products      PromotionProduct[]
  categories    PromotionCategory[]
  brands        PromotionBrand[]
}

model PromotionProduct {
  id          String    @id @default(uuid())
  promotionId String
  productId   String
  promotion   Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([promotionId, productId])
}

model PromotionCategory {
  id          String    @id @default(uuid())
  promotionId String
  category    String
  promotion   Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)

  @@unique([promotionId, category])
}

model PromotionBrand {
  id          String    @id @default(uuid())
  promotionId String
  brand       String
  promotion   Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)

  @@unique([promotionId, brand])
}

model AuditLog {
  id        String   @id @default(uuid())
  adminName String
  section   String
  oldValue  Json
  newValue  Json
  ipAddress String?
  createdAt DateTime @default(now())
}

enum CampaignType {
  PERCENTAGE_DISCOUNT
  FLAT_DISCOUNT
  BUY_X_GET_Y
  FREE_SHIPPING
  COUPON
  FLASH_SALE
  CATEGORY_DISCOUNT
  BRAND_DISCOUNT
  PRODUCT_DISCOUNT
}

enum CampaignStatus {
  DRAFT
  SCHEDULED
  ENABLED
  DISABLED
  EXPIRED
  ARCHIVED
}

enum ApplyToType {
  STORE
  CATEGORY
  BRAND
  PRODUCT
}

enum EmailStatus {
  PENDING
  PROCESSING
  SENT
  FAILED
}

enum EmailProvider {
  SMTP
  SES
  SENDGRID
  MAILGUN
  POSTMARK
  RESEND
}

model EmailLog {
  id                  String        @id @default(uuid())
  userId              String?
  user                User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  email               String
  template            String
  subject             String
  status              EmailStatus   @default(PENDING)
  provider            EmailProvider @default(SMTP)
  messageId           String?
  error               String?
  sentAt              DateTime?
  retryCount          Int           @default(0)
  processingStartedAt DateTime?
  completedAt         DateTime?
  nextRetryAt         DateTime?
  idempotencyKey      String?       @unique
  createdAt           DateTime      @default(now())

  @@index([userId])
  @@index([email])
  @@index([createdAt])
}

model BrandingSettings {
  id           String   @id @default(uuid())
  platformName String   @default("LuxeHome")
  logoUrl      String?
  logoPublicId String?
  emailLogoUrl      String?
  emailLogoPublicId String?
  faviconUrl   String?
  primaryColor String?
  supportEmail String?
  supportPhone String?
  websiteUrl   String?
  brandingVersion Int   @default(1)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

